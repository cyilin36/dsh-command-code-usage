{
  "name": "dsh-command-code-usage",
  "version": "1.0.0",
  "description": "Command Code plan usage monitor for DeepSeek Harness: a floating web dock showing live credits and the 5h-rolling / weekly quota windows, plus a ready-made command-code model provider preset",
  "author": {
    "name": "cyilin36",
    "url": "https://github.com/cyilin36"
  },
  "homepage": "https://github.com/cyilin36/dsh-command-code-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyilin36/dsh-command-code-usage.git"
  },
  "bugs": {
    "url": "https://github.com/cyilin36/dsh-command-code-usage/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "commandcode",
    "command-code",
    "usage",
    "quota",
    "monitor",
    "credits"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "verify": "node scripts/verify.mjs",
    "prepublishOnly": "pnpm build && pnpm verify"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.9"
  }
}
